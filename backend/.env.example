# Database Connection Examples:
# MySQL:
# DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/recovery_db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/recovery
# SQLite (Local Dev):
DATABASE_URL=sqlite+aiosqlite:///./recovery.db

# Runtime security. Production requires a long, randomly generated API_AUTH_TOKEN.
ENVIRONMENT=development
API_AUTH_TOKEN=replace_with_a_long_random_secret
RATE_LIMIT_PER_MINUTE=120

# Required by docker-compose; use distinct, strong values from a secret manager.
POSTGRES_PASSWORD=replace_with_a_strong_database_password
REDIS_PASSWORD=replace_with_a_strong_redis_password

# Redis Cache & Celery Broker
REDIS_URL=redis://localhost:6379/0

# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini

# LangSmith Observability & Tracing (Backend Only)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=RecoveraX
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Demo Mode & Retry Configurations
DEMO_MODE=false
DEMO_RETRY_DELAY_SECONDS=10

# Safety Policy Engine Thresholds
MAX_AUTO_RETRY_AMOUNT=5000
MAX_RETRIES=2
MIN_AUTO_RECOVERY_SCORE=80
HUMAN_APPROVAL_AMOUNT=5000
